# Copy backend/.env.example to backend/.env and frontend/.env.example to frontend/.env.
# These variables are consumed by those separate processes, not from this root file.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nourish
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_TIMEZONE=Asia/Kolkata
VITE_API_BASE_URL=/api
